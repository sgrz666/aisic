# 本地直跑可使用 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite+pysqlite:///./data/edusci.db
TASK_MODE=inline
STORAGE_ROOT=./storage

# 阿里云百炼（留空时使用确定性演示逻辑）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_GENERATION_MODEL=qwen-plus
QWEN_REVIEW_MODEL=qwen-max

# true 时调用 Crossref 与 Semantic Scholar；失败会降级为空证据集。
ENABLE_LIVE_RETRIEVAL=false

# 自治研究
AUTONOMOUS_RESEARCH_ENABLED=true
SEMANTIC_SCHOLAR_API_KEY=
AUTONOMOUS_MAX_LITERATURE_ROUNDS=3
AUTONOMOUS_MAX_RESULTS_PER_QUERY=10
AUTONOMOUS_DOWNLOAD_LIMIT_MB=50

# Docker/RQ
REDIS_URL=redis://redis:6379/0
